// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum SystemRole {
  OWNER
  ADMIN
  STAFF
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

// ─────────────────────────────────────────
// PLANES Y MÓDULOS
// ─────────────────────────────────────────

model Plan {
  id          String   @id @default(uuid())
  name        String   @unique
  price       Decimal  @db.Decimal(10, 2)
  maxStaff    Int
  maxServices Int
  isActive    Boolean  @default(true)

  // Módulos habilitados para este plan
  hasAppointments Boolean @default(true)
  hasCRM          Boolean @default(true)
  hasStats        Boolean @default(false)
  hasEcommerce    Boolean @default(false)
  hasInventory    Boolean @default(false)

  tenants Tenant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────
// TENANT
// ─────────────────────────────────────────

model Tenant {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true)

  planId    String?
  plan      Plan?     @relation(fields: [planId], references: [id])

  memberships   Membership[]
  services      Service[]
  customers     Customer[]
  appointments  Appointment[]

  //Auditoria
  createdBy      String?
  updatedBy      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// ─────────────────────────────────────────
// USUARIOS Y ACCESO
// ─────────────────────────────────────────

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  name     String?
  phone    String?

  memberships Membership[]
  passwordReset PasswordResetToken[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Membership {
  id       String     @id @default(uuid())
  role     SystemRole @default(STAFF)

  userId   String
  tenantId String

  user     User   @relation(fields: [userId], references: [id])
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]

  // Permisos granulares opcionales sobre el rol base
  permissions MembershipPermission[]

  //Auditoria
  createdBy      String?
  updatedBy      String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

model Permission {
  id   String @id @default(uuid())
  // Ejemplo: "appointments:create", "crm:read", "stats:view"
  name String @unique

  memberships MembershipPermission[]
}

model MembershipPermission {
  membershipId String
  permissionId String

  membership Membership @relation(fields: [membershipId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([membershipId, permissionId])
}

model RefreshToken {
  id  String  @id @default(uuid())
  tokenHash String  @unique
  familyId  String
  membershipId  String

  membership Membership @relation(fields: [membershipId], references:[id])


  createdAt DateTime @default(now())
  expiresAt DateTime 
  revokedAt DateTime?
  replacedById String?

  @@index([familyId])
}

model PasswordResetToken {
  id String @id @default(uuid())
  tokenHash String @unique
  userId String

  user User @relation(fields: [userId], references:[id])

  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────
// MÓDULO: TURNOS // AGENDA
// ─────────────────────────────────────────

model Service {
  id          String  @id @default(uuid())
  name        String
  description String?
  duration    Int     // en minutos
  price       Decimal @db.Decimal(10, 2)
  isActive    Boolean @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  appointments Appointment[]

  //Auditoria
  createdBy      String?
  updatedBy      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
}

model Appointment {
  id        String            @id @default(uuid())
  status    AppointmentStatus @default(PENDING)
  startTime DateTime
  endTime   DateTime
  notes     String?

  tenantId   String
  customerId String
  serviceId  String
  staffId    String           // userId del miembro con rol STAFF o ADMIN

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])

  //Auditoria
  createdBy      String?
  updatedBy      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([customerId])
  @@index([staffId])
  @@index([startTime])        // clave para queries de agenda por fecha
}

// ─────────────────────────────────────────
// MÓDULO: CRM / CLIENTES
// ─────────────────────────────────────────

model Customer {
  id      String         @id @default(uuid())
  name    String
  email   String?
  phone   String?
  status  CustomerStatus @default(ACTIVE)
  notes   String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  appointments Appointment[]

  //Auditoria
  createdBy      String?
  updatedBy      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tenantId, email])  // email único por tenant, no global
  @@index([tenantId])
}